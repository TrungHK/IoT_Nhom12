# Cấu hình Firebase Web App (Lấy từ Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=smart-parking-iot.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://smart-parking-iot-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=smart-parking-iot
VITE_FIREBASE_STORAGE_BUCKET=smart-parking-iot.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
